---
// Функциональные иконки 16 px: наследуют цвет текста, всегда рядом с подписью или с aria-label у кнопки.
const paths = {
  sun: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"/>',
  moon: '<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"/>',
  menu: '<path d="M2.5 4h11M2.5 8h11M2.5 12h7"/>',
  x: '<path d="m4 4 8 8M12 4l-8 8"/>',
  margin: '<rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M10 2.5v11"/>',
  chevron: '<path d="m6 4 4 4-4 4"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={["icon", className]} viewBox="0 0 16 16" aria-hidden="true" set:html={paths[name]} />
