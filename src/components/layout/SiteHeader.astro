---
// Шапка: знак и «Курсы ML» ведут в каталог; рядом — текущий курс и прогресс по нему; переключатель темы.
// Поиска и повторения нет (решение заказчика 14.10.2026).
import type { CourseTree } from "../../lib/content/catalog";
import { ofLessons } from "../../i18n/ru";
import CheckMark from "./CheckMark.astro";
import Icon from "./Icon.astro";

interface Props {
  course?: CourseTree;
  /** Кнопка оглавления на узком экране — только там, где оглавление есть. */
  withToc?: boolean;
}
const { course, withToc = false } = Astro.props;
const total = course?.required ?? 0;
---
<header class="site-header">
  <div class="site-header__inner">
    {withToc && (
      <button class="icon-button toc-toggle" type="button" data-toc-toggle aria-controls="toc" aria-expanded="false" aria-label="Оглавление курса">
        <Icon name="menu" />
      </button>
    )}
    <a class:list={["brand", !course && "brand--home"]} href="/">
      <svg class="brand__mark" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path class="cell" d="M1 6h20M1 11h20M1 16h20M6 1v20M11 1v20M16 1v20" stroke-width="1" />
        <rect class="frame" x="1" y="1" width="20" height="20" rx="3" stroke-width="1.2" />
        <path class="vec" d="M3.5 17.5 18.5 5" stroke-width="1.8" stroke-linecap="round" />
        <circle class="dot" cx="6" cy="12.5" r="1.7" /><circle class="dot" cx="11" cy="12" r="1.7" /><circle class="dot" cx="15.5" cy="6.5" r="1.7" />
      </svg>
      <span class="brand__name">Курсы ML</span>
    </a>
    {course && (
      <>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a class="course-name" href={course.href}>{course.title}</a>
      </>
    )}
    <div class="header-progress" data-course={course?.id} data-progress-lessons={course ? JSON.stringify(course.lessons.filter((l) => !l.optional).map((l) => l.key)) : undefined}>
      {course && (
        <>
          <span class="label">
            <span class="hide-narrow">Знаю <span data-known-total>0</span> из <span data-known-of>{total}</span> {ofLessons(total)} курса</span>
            <span class="show-narrow">
              <CheckMark class="status status--passed" />
              <span class="visually-hidden">Знаю </span><span data-known-total>0</span> из {total}<span class="visually-hidden"> {ofLessons(total)} курса</span>
            </span>
          </span>
          <span class="progress" aria-hidden="true"><span data-known-bar style="width: 0%"></span></span>
        </>
      )}
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Тёмная тема" aria-pressed="false">
        <Icon name="sun" class="sun" /><Icon name="moon" class="moon" />
      </button>
    </div>
  </div>
</header>
