---
// Обёртка виджета «Вычислительный граф» для урока: рисунок с номером и подписью, остров React (client:visible).
import { CompGraph, type CompGraphProps } from "../../widgets/calc/comp-graph";

interface Props extends CompGraphProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <CompGraph client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
