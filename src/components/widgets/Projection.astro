---
// Обёртка виджета «Проекция с подвижным углом» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Projection, type ProjectionProps } from "../../widgets/la/projection";

interface Props extends ProjectionProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Projection client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
