---
// Обёртка виджета «Деформация сетки» для урока: рисунок с номером и подписью, остров React (client:visible).
import { GridMap, type GridMapProps } from "../../widgets/la/grid-map";

interface Props extends GridMapProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <GridMap client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
