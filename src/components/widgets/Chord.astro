---
// Обёртка виджета «Хорда над графиком» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Chord, type ChordProps } from "../../widgets/calc/chord";

interface Props extends ChordProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Chord client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
