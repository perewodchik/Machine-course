---
// Обёртка виджета «Обозреватель непрерывных распределений» для урока: рисунок с номером и подписью, остров React (client:visible).
import { ContExplorer, type ContExplorerProps } from "../../widgets/prob/cont-explorer";

interface Props extends ContExplorerProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <ContExplorer client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
