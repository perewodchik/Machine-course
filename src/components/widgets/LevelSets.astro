---
// Обёртка виджета «Линии уровня xᵀAx» для урока: рисунок с номером и подписью, остров React (client:visible).
import { LevelSets, type LevelSetsProps } from "../../widgets/la/level-sets";

interface Props extends LevelSetsProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <LevelSets client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
