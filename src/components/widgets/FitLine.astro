---
// Обёртка виджета «Подгонка прямой» для урока: рисунок с номером и подписью, остров React (client:visible).
// Обёртка нужна MDX: компоненты урока передаёт сайт, а директиву client:* можно поставить только здесь.
import { FitLine, type FitLineProps } from "../../widgets/la/fit-line";

interface Props extends FitLineProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <FitLine client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
