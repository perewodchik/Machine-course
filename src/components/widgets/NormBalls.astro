---
// Обёртка виджета «Единичные шары норм» для урока: рисунок с номером и подписью, остров React (client:visible).
import { NormBalls, type NormBallsProps } from "../../widgets/la/norm-balls";

interface Props extends NormBallsProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <NormBalls client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
