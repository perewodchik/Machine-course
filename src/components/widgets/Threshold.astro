---
// Обёртка виджета «Порог классификатора» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Threshold, type ThresholdProps } from "../../widgets/ml/threshold";

interface Props extends ThresholdProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Threshold client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
