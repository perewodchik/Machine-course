---
// Обёртка виджета «Путь регуляризации» для урока: рисунок с номером и подписью, остров React (client:visible).
import { RegPath } from "../../widgets/ml/reg-path";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <RegPath client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
