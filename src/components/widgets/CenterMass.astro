---
// Обёртка виджета «Матожидание как центр масс» для урока: рисунок с номером и подписью, остров React (client:visible).
import { CenterMass, type CenterMassProps } from "../../widgets/prob/center-mass";

interface Props extends CenterMassProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <CenterMass client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
