---
// Обёртка виджета «Порог: кривые и цена» для урока: рисунок с номером и подписью, остров React (client:visible).
import { ThresholdLab } from "../../widgets/ml/threshold-lab";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <ThresholdLab client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
