---
// Обёртка виджета «Обучение и тест» для урока: рисунок с номером и подписью, остров React (client:visible).
import { TrainTest, type TrainTestProps } from "../../widgets/ml/train-test";

interface Props extends TrainTestProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <TrainTest client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
