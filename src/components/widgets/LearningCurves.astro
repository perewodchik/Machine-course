---
// Обёртка виджета «Кривые обучения» для урока: рисунок с номером и подписью, остров React (client:visible).
import { LearningCurves } from "../../widgets/ml/learning-curves";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <LearningCurves client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
