---
// Обёртка виджета «Окружность → эллипс по шагам» для урока: рисунок с номером и подписью, остров React (client:visible).
import { SvdSteps, type SvdStepsProps } from "../../widgets/la/svd-steps";

interface Props extends SvdStepsProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <SvdSteps client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
