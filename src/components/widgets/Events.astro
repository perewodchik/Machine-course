---
// Обёртка виджета «События как области» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Events, type EventsProps } from "../../widgets/prob/events";

interface Props extends EventsProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Events client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
