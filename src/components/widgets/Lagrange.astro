---
// Обёртка виджета «Касание линии уровня и ограничения» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Lagrange, type LagrangeProps } from "../../widgets/calc/lagrange";

interface Props extends LagrangeProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Lagrange client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
