---
// Обёртка виджета «Редактор μ и Σ» для урока: рисунок с номером и подписью, остров React (client:visible).
import { GaussEditor, type GaussEditorProps } from "../../widgets/prob/gauss-editor";

interface Props extends GaussEditorProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <GaussEditor client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
