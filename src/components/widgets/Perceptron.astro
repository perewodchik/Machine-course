---
// Обёртка виджета «Перцептрон» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Perceptron } from "../../widgets/ml/perceptron";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <Perceptron client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
