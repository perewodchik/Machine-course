---
// Обёртка виджета «Касательные Ньютона» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Newton, type NewtonProps } from "../../widgets/calc/newton";

interface Props extends NewtonProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Newton client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
