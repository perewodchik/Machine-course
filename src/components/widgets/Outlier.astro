---
// Обёртка виджета «Перетащи выброс» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Outlier, type OutlierProps } from "../../widgets/stat/outlier";

interface Props extends OutlierProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Outlier client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
