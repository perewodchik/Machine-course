---
// Обёртка виджета «Области классов» для урока: рисунок с номером и подписью, остров React (client:visible).
import { ClassRegions } from "../../widgets/ml/class-regions";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <ClassRegions client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
