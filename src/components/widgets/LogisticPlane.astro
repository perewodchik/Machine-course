---
// Обёртка виджета «Сигмоида над плоскостью» для урока: рисунок с номером и подписью, остров React (client:visible).
import { LogisticPlane } from "../../widgets/ml/logistic-plane";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <LogisticPlane client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
