---
// Обёртка виджета «Облако моделей» для урока: рисунок с номером и подписью, остров React (client:visible).
import { ModelCloud } from "../../widgets/ml/model-cloud";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <ModelCloud client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
