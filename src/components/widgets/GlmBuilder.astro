---
// Обёртка виджета «Конструктор GLM» для урока: рисунок с номером и подписью, остров React (client:visible).
import { GlmBuilder } from "../../widgets/ml/glm-builder";

interface Props {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n } = Astro.props;
---
<figure class="figure wide">
  <GlmBuilder client:visible />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
