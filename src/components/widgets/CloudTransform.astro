---
// Обёртка виджета «Линейное преобразование облака» для урока: рисунок с номером и подписью, остров React (client:visible).
import { CloudTransform, type CloudTransformProps } from "../../widgets/prob/cloud-transform";

interface Props extends CloudTransformProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <CloudTransform client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
