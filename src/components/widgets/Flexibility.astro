---
// Обёртка виджета «Гибкость модели» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Flexibility, type FlexibilityProps } from "../../widgets/ml/flexibility";

interface Props extends FlexibilityProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Flexibility client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
