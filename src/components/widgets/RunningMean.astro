---
// Обёртка виджета «Бегущее среднее» для урока: рисунок с номером и подписью, остров React (client:visible).
import { RunningMean, type RunningMeanProps } from "../../widgets/prob/limit-theorems";

interface Props extends RunningMeanProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <RunningMean client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
