---
// Обёртка виджета «Активное и неактивное ограничение» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Kkt, type KktProps } from "../../widgets/calc/kkt";

interface Props extends KktProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Kkt client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
