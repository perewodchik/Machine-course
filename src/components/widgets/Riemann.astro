---
// Обёртка виджета «Сумма прямоугольников → площадь» для урока: рисунок с номером и подписью, остров React (client:visible).
import { Riemann, type RiemannProps } from "../../widgets/calc/riemann";

interface Props extends RiemannProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <Riemann client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
