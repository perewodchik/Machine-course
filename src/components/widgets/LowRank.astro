---
// Обёртка виджета «Сжать картинку SVD» для урока: рисунок с номером и подписью, остров React (client:visible).
import { LowRank, type LowRankProps } from "../../widgets/la/low-rank";

interface Props extends LowRankProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <LowRank client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
