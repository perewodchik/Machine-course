---
// Обёртка виджета «Сетка из 1000 человек» для урока: рисунок с номером и подписью, остров React (client:visible).
import { BayesGrid, type BayesGridProps } from "../../widgets/prob/bayes-grid";

interface Props extends BayesGridProps {
  /** Номер рисунка в уроке. */
  n?: number;
}
const { n, ...props } = Astro.props;
---
<figure class="figure wide">
  <BayesGrid client:visible {...props} />
  <figcaption class="figure__caption">{n && <b>Рисунок {n}.</b>} <slot /></figcaption>
</figure>
