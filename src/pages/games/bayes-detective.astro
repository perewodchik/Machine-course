---
// Игра «Байес-детектив» (S2.13): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BayesDetective, meta } from "../../games/bayes-detective";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Улики приходят по одной: оцените вероятность гипотезы после каждой. Очки — по логарифмическому правилу." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Улики приходят по одной. После каждой оцените вероятность гипотезы. Очки начисляются по логарифмическому правилу: максимум получает только честная байесовская оценка. Партия&nbsp;— 3–5&nbsp;минут.</p>
    <BayesDetective client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Улика умножает шансы гипотезы на отношение правдоподобия: во сколько раз она вероятнее, если гипотеза верна. Апостериорная вероятность после одной улики&nbsp;— априорная для следующей.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </BayesDetective>
  </main>
</BaseLayout>
