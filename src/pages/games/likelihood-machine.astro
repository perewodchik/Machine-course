---
// Игра «Машина правдоподобия» (S4.L4, урок IV.3): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LikelihoodMachine, meta } from "../../games/likelihood-machine";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Найдите максимум логарифма правдоподобия за шесть замеров — или сразу по формуле оценки." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Перед вами выборка и скрытая кривая логарифма правдоподобия. Шесть замеров, чтобы найти её вершину,&nbsp;— или ни одного, если знаете формулу оценки. Пять уровней, партия&nbsp;— <span class="nowrap">3–5&nbsp;минут</span>.</p>
    <LikelihoodMachine client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Оценка максимального правдоподобия&nbsp;— вершина кривой <i>ℓ</i>(<i>θ</i>), и для частых семейств её дают простые формулы: доля успехов, выборочное среднее, обратное к&nbsp;среднему. Правдоподобие&nbsp;— функция параметра при фиксированных данных, а&nbsp;не вероятность параметра.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </LikelihoodMachine>
  </main>
</BaseLayout>
