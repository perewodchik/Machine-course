---
// Игра «Минимум, максимум или седло» (S4.L2, урок II.4): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MinMaxSaddle, meta } from "../../games/min-max-saddle";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="По линиям уровня или по гессиану определите, что перед вами: минимум, максимум, седло или случай, где гессиан ничего не решает." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">В критической точке градиент равен нулю, и функцию описывает гессиан <i>H</i>. Назовите тип точки — сначала по линиям уровня, потом только по числам. Пять уровней, партияпартия&nbsp;— 3–5&nbsp;минут.nbsp;— <span class="nowrap">3–5партия&nbsp;— 3–5&nbsp;минут.nbsp;минут</span>.</p>
    <MinMaxSaddle client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Тип критической точки решают знаки собственных значений гессиана: оба положительны&nbsp;— минимум, оба отрицательны&nbsp;— максимум, разных знаков&nbsp;— седло. Если одно равно нулю, гессиан ответа не даёт.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </MinMaxSaddle>
  </main>
</BaseLayout>
