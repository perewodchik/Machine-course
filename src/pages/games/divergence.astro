---
// Игра «Порог расходимости» (S4.L2, урок II.6): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Divergence, meta } from "../../games/divergence";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Подберите наибольший шаг градиентного спуска, при котором он ещё сходится, и проверьте порог 2/λ_max." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Градиентный спуск на чаше ½&nbsp;<i>x</i>ᵀ<i>Ax</i>: чем больше шаг <i>η</i>, тем быстрее спуск, пока он не начнёт расходиться. Найдите наибольший шаг, при котором спуск ещё сходится. Пять уровней, партия&nbsp;— <span class="nowrap">4–6&nbsp;минут</span>.</p>
    <Divergence client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Шаг <i>x</i>&nbsp;:= <i>x</i>&nbsp;− <i>ηAx</i> умножает координату вдоль собственного вектора на 1&nbsp;− <i>ηλ</i>. Спуск сходится, пока все множители по модулю меньше единицы, то&nbsp;есть при <span class="nowrap">0&nbsp;&lt; <i>η</i>&nbsp;&lt; 2/<i>λ</i><sub>max</sub></span>. Порог задаёт наибольшее собственное значение, а скорость у вытянутой чаши&nbsp;— наименьшее.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </Divergence>
  </main>
</BaseLayout>
