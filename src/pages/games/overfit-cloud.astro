---
// Игра «Переобучи, если сможешь: облако» (урок 2.2 «Основ ML»): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { OverfitCloud, meta } from "../../games/overfit-cloud";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("ml-basics");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Предскажите по объёму данных и шуму степень полинома с наименьшей ожидаемой ошибкой, затем посмотрите на облако из 100 моделей." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Модель, обученная на&nbsp;случайной выборке, сама случайна. По&nbsp;объёму выборки <i>n</i> и&nbsp;шуму <i>σ</i> предскажите степень полинома с&nbsp;наименьшей ожидаемой ошибкой на&nbsp;свежих данных&nbsp;— а&nbsp;потом посмотрите на&nbsp;облако из&nbsp;100&nbsp;моделей. Четыре уровня, партия&nbsp;— <span class="nowrap">3–5&nbsp;минут</span>.</p>
    <OverfitCloud client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Гибкость окупается, только когда данных много, а&nbsp;шума мало: разброс растёт примерно как <i>σ</i>²·<i>d</i>/<i>n</i>. На&nbsp;малой шумной выборке прямая или константа ошибаются меньше любой кривой.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </OverfitCloud>
  </main>
</BaseLayout>
