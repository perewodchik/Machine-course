---
// Игра «Угадай корреляцию» (S4.L3, урок III.9): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GuessCorrelation, meta } from "../../games/guess-correlation";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="По облаку точек угадайте выборочную корреляцию: знак, сила связи, ловушки нелинейной зависимости и выбросов." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Корреляция&nbsp;— одно число, а облако точек&nbsp;— картинка. Научитесь видеть число по картинке и узнавать облака, где оно обманывает. Пять уровней, партия&nbsp;— <span class="nowrap">3–5&nbsp;минут</span>.</p>
    <GuessCorrelation client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Знак корреляции&nbsp;— куда вытянуто облако, величина&nbsp;— насколько оно узкое вокруг прямой. Корреляция видит только линейную связь: у&nbsp;параболы и&nbsp;кольца она около нуля, хотя <i>y</i> зависит от&nbsp;<i>x</i>, а&nbsp;один выброс может создать её из&nbsp;ничего.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </GuessCorrelation>
  </main>
</BaseLayout>
