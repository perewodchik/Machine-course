---
// Игра «Переобучи, если сможешь: финал» (урок 2.4 «Основ ML»): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { OverfitFinal, meta } from "../../games/overfit-final";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("ml-basics");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Выберите степень полинома и λ по отложенной части или кросс-валидации; скрытый тест открывается один раз и завершает уровень." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Отдельной валидации нет&nbsp;— есть <i>n</i> объектов и&nbsp;закрытый тест. Оцените модели отложенной частью или кросс-валидацией, выберите степень и&nbsp;<i>λ</i> и&nbsp;сдайте модель: тест откроется один раз, второй попытки на&nbsp;уровне нет. Четыре уровня, партия&nbsp;— <span class="nowrap">4–6&nbsp;минут</span>.</p>
    <OverfitFinal client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Когда данных много, одной отложенной части хватает. Когда мало&nbsp;— её оценка шумная, и&nbsp;кросс-валидация выбирает надёжнее. Если истина проста, а&nbsp;шум велик, лучшая модель&nbsp;— самая простая: правило одной SE. Тест открывают один раз, после выбора.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </OverfitFinal>
  </main>
</BaseLayout>
