---
// Игра «Underflow» (S3.L0, урок 0.5): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Underflow, meta } from "../../games/underflow";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Предскажите, на каком объекте произведение вероятностей станет нулём во float, и перейдите к логарифмам." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Правдоподобие&nbsp;— произведение вероятностей всех объектов. Предскажите, на каком объекте оно станет нулём в&nbsp;числах с&nbsp;плавающей точкой, а потом посмотрите, что делает логарифм. Пять уровней, партия&nbsp;— 3–5&nbsp;минут.</p>
    <Underflow client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Произведение тысяч вероятностей меньше самого маленького числа float64, и компьютер записывает его нулём. Логарифм превращает произведение в&nbsp;сумму умеренных чисел, а точку максимума не меняет&nbsp;— поэтому в&nbsp;CS229 максимизируют логарифм правдоподобия.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </Underflow>
  </main>
</BaseLayout>
