---
// Игра «Цена ошибки» (S7.04, урок 2.1 «Основ ML»): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ErrorCost, meta } from "../../games/error-cost";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("ml-basics");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Выберите порог классификатора так, чтобы ошибки обошлись дешевле всего, когда пропуск и ложная тревога стоят по-разному." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Модель выдаёт вероятность, решение принимает порог. Пропуск и&nbsp;ложная тревога стоят по-разному&nbsp;— выберите порог, при&nbsp;котором ошибки обойдутся дешевле всего. Пять уровней, партия&nbsp;— <span class="nowrap">4–6&nbsp;минут</span>.</p>
    <ErrorCost client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Порог 0.5 правилен, только когда обе ошибки стоят одинаково. Если вероятности честные, отмечать объект выгодно при <i>p</i>&nbsp;&gt;&nbsp;<i>c</i><sub>fp</sub>&nbsp;/&nbsp;(<i>c</i><sub>fp</sub>&nbsp;+&nbsp;<i>c</i><sub>fn</sub>): чем дороже пропуск, тем ниже порог.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </ErrorCost>
  </main>
</BaseLayout>
