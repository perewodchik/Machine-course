---
// Игра «Честная вероятность» (урок 1.4 «Основ ML»): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HonestProbability, meta } from "../../games/honest-probability";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("ml-basics");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Подберите границу и крутизну сигмоиды так, чтобы вероятности были честными: логарифмическое правило против максимума правдоподобия." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Логистическая модель выдаёт вероятность метки&nbsp;1. Отметьте, где, по-вашему, лучшая граница, потом подберите границу и&nbsp;крутизну сигмоиды: очки&nbsp;— средний логарифм вероятности верной метки. Четыре уровня, партия&nbsp;— <span class="nowrap">2–4&nbsp;минуты</span>.</p>
    <HonestProbability client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Максимум правдоподобия&nbsp;— это честные вероятности: слишком пологая сигмоида недоверчива, слишком крутая дорого платит за&nbsp;каждую уверенную ошибку. На&nbsp;разделимых данных максимума нет: чем круче, тем лучше, и&nbsp;веса уходят в&nbsp;бесконечность.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </HonestProbability>
  </main>
</BaseLayout>
