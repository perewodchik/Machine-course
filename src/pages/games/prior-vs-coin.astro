---
// Игра «Приор против монеты» (S4.L4, урок IV.6): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PriorVsCoin, meta } from "../../games/prior-vs-coin";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Выберите априорное распределение и обыграйте MLE-бота в предсказании монет по нескольким броскам." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">По&nbsp;трём броскам монеты MLE уверенно скажет «всегда орёл». Выберите априорное распределение так, чтобы ваши прогнозы на&nbsp;будущие броски оказались точнее. Пять уровней, партия&nbsp;— <span class="nowrap">3–5&nbsp;минут</span>.</p>
    <PriorVsCoin client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Априорное Beta(<i>α</i>,&nbsp;<i>β</i>)&nbsp;— это <i>α</i> воображаемых орлов и&nbsp;<i>β</i> решек. При малой выборке хороший приор спасает от&nbsp;нулевых вероятностей и&nbsp;крайних оценок, при большой&nbsp;— почти ничего не&nbsp;меняет. Beta(1,&nbsp;1) даёт сглаживание Лапласа.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </PriorVsCoin>
  </main>
</BaseLayout>
