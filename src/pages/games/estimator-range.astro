---
// Игра «Тир оценок» (S4.L4, урок IV.2): остров React с оболочкой GameShell. Блок «Чему учит игра» — статичный HTML.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EstimatorRange, meta } from "../../games/estimator-range";
import { loadCourse } from "../../lib/content/collections";

const course = await loadCourse("foundations");
const lesson = course.lessons.find((l) => l.key === meta.lesson);
if (!lesson) throw new Error(`игра ${meta.id}: нет урока ${meta.lesson}`);
const module = course.modules.find((m) => m.id === lesson.module);
---
<BaseLayout title={meta.title} description="Подберите коэффициент сжатия оценки так, чтобы 200 выстрелов легли как можно ближе к мишени: смещение против разброса." course={course}>
  <main class="game shell" id="content">
    <nav class="breadcrumb" aria-label="Путь">
      <a href={`${course.href}#m-${lesson.module}`}>{module?.title}</a><span aria-hidden="true">/</span><span>Игра к уроку {lesson.number}</span>
    </nav>
    <h1>{meta.title}</h1>
    <p class="lead game__lead">Оценка по выборке&nbsp;— выстрел: каждая новая выборка ложится в&nbsp;своё место. Подберите, насколько сжать оценку к&nbsp;нулю, чтобы залп из&nbsp;200 выстрелов в&nbsp;среднем лёг ближе всего к&nbsp;мишени. Пять уровней, партия&nbsp;— <span class="nowrap">4–6&nbsp;минут</span>.</p>
    <EstimatorRange client:load>
      <div class="block block--intuition game__teaches">
        <p><span class="block__title">Чему учит игра.</span> Среднеквадратичная ошибка оценки&nbsp;— смещение² плюс дисперсия. Несмещённая оценка не&nbsp;всегда лучшая: когда данных мало или шум велик, сжатие обменивает небольшое смещение на&nbsp;большой выигрыш в&nbsp;разбросе&nbsp;— так работает регуляризация.</p>
        <p><a href={lesson.href}>Урок {lesson.number}. {lesson.title}</a></p>
      </div>
    </EstimatorRange>
  </main>
</BaseLayout>
