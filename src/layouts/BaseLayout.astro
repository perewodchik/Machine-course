---
// Каркас страницы: <head>, тема и поля без мигания, шапка, ссылка «К содержимому», общий клиентский скрипт.
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import type { CourseTree } from "../lib/content/catalog";
import { getEntry } from "astro:content";

interface Props {
  title: string;
  description?: string;
  course?: CourseTree;
  withToc?: boolean;
  /** Служебные страницы (демо-урок) не индексируются. */
  noindex?: boolean;
}
const { title, description, course, withToc = false, noindex = false } = Astro.props;
const fullTitle = course ? `${title} — ${course.title}` : title;
// переименования уроков (content/redirects.yaml): по ним мигрируют сохранённые отметки «знаю»
const lessonRedirects = (await getEntry("redirects", "lessons"))?.data ?? {};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <!-- Тема и поля — до первой отрисовки, иначе страница мигнёт светлой темой и полями -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js"); // компоненты с поведением прячут лишнее до отрисовки, без JS видно всё
        let theme, margins, pilot;
        try {
          // режим пилота (S2.10): ?pilot=1 включает задания «до урока», ?pilot=0 выключает; запоминается в браузере
          const flag = new URLSearchParams(location.search).get("pilot");
          if (flag === "1") localStorage.setItem("mlf:pilot", "1");
          if (flag === "0") localStorage.removeItem("mlf:pilot");
          theme = localStorage.getItem("theme"); margins = localStorage.getItem("margins"); pilot = localStorage.getItem("mlf:pilot");
        } catch { /* приватный режим */ }
        if (theme === "light" || theme === "dark") root.dataset.theme = theme;
        if (margins === "hidden") root.dataset.margins = "hidden";
        if (pilot === "1") root.dataset.pilot = "on";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">К содержимому</a>
    <SiteHeader course={course} withToc={withToc} />
    <slot />
    <script type="application/json" id="lesson-redirects" set:html={JSON.stringify(lessonRedirects)} />
    <script>
      import "../client/layout";
      import "../client/symbols";
      import "../client/scrollable";
      import "../client/tabs";
      import "../client/derivation";
      import "../client/exercise";
      import "../client/know";
      import "../client/diagnostic";
      import "../python/cell";
      import "../client/survey";
    </script>
  </body>
</html>
